# Synapse Backend Environment Configuration
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Security & CORS
FRONTEND_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
JWT_SECRET_KEY=your-backend-secret-key-change-in-production

# Supabase Project Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-keep-private
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-for-token-validation
SUPABASE_STORAGE_BUCKET_DOCS=documents

# Hugging Face AI Configuration
HF_TOKEN=hf_your_hugging_face_user_access_token
HF_API_BASE_URL=https://api-inference.huggingface.co/models
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_SUMMARIZATION_MODEL=facebook/bart-large-cnn
HF_GENERATION_MODEL=meta-llama/Llama-3.2-3B-Instruct
HF_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
HF_REQUEST_TIMEOUT_SECONDS=30.0
HF_MAX_RETRIES=3

# Rate Limiting
RATE_LIMIT_AI_REQUESTS_PER_MINUTE=20
RATE_LIMIT_BURST=5
